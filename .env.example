# Flask application configuration
SECRET_KEY=replace-with-a-random-value-of-at-least-32-bytes
FLASK_DEBUG=false
USE_SSL=true
CORS_ALLOWED_ORIGINS=https://your-domain.example
SOCKETIO_CORS_ALLOWED_ORIGINS=https://your-domain.example
ADMIN_BOOTSTRAP_PASSWORD=choose-a-unique-admin-password
HOSPITAL_BOOTSTRAP_PASSWORD=choose-a-unique-hospital-password

# Select the AI provider: GROQ
AI_PROVIDER=GROQ

# Groq API key for symptom analysis
GROQ_API_KEY=gsk_yourActualKeyHere
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_API_MODEL=openai/gpt-oss-20b

# Google Vision API for image analysis (optional)
GOOGLE_VISION_API_KEY=your-google-vision-api-key-here
ENABLE_IMAGE_ANALYSIS=true


# Google OAuth for Login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign In OAuth (Optional)
APPLE_CLIENT_ID=com.spherixclinic.web
APPLE_TEAM_ID=your-apple-developer-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8
# APPLE_CLIENT_SECRET=your-pregenerated-client-secret-jwt

# Cloudinary Cloud Storage for Images (Free 25 GB)
CLOUDINARY_CLOUD_NAME=v138vp7z
CLOUDINARY_API_KEY=394861331335724
CLOUDINARY_API_SECRET=**********
# Alternatively, single URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Spherix Secure CAPTCHA & Store Configuration
# Set SPHERIX_CAPTCHA_STORE=memory for local development / serverless without Redis
SPHERIX_CAPTCHA_STORE=memory
REDIS_URL=redis://127.0.0.1:6379/0
# Alternatively, granular connection params:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-auth-token
CAPTCHA_SECRET_KEY=replace-with-a-random-hmac-secret-for-captcha
CAPTCHA_TTL_SECONDS=180

# Spherix Clinic Enterprise Cybersecurity & PHI Encryption
DATA_ENCRYPTION_KEY=replace-with-a-random-32-byte-hex-key-for-phi-aes256
SQLITE_DB_PATH=spherixclinic.db
ENABLE_HTTPS_COOKIES=false
CERTIN_INCIDENT_REPORTING_EMAIL=security@spherixclinic.com
DPDP_DPO_EMAIL=dpo@spherixclinic.com


